{
  // The admin scripts are Node programs run through tsx, but they import worker
  // modules that speak D1 -- so they need Node's globals and Cloudflare's both.
  //
  // This project exists because `scripts/` was in no tsconfig `include`, so the
  // build's other passes could not see it. A wrong-arity call to
  // `partnerByEmail` therefore shipped in the one command an operator reaches
  // for when a commission edge is wrong, and it failed on its first statement
  // for every input with nothing in the pipeline able to notice.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "@cloudflare/workers-types"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    // The worker imports its knowledge base as JSON, and `ask-eval.ts` imports
    // the worker.
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false
  },
  // `argv.ts` is listed even though `partners.ts` imports it, so it stays
  // checked if that import ever goes: a parser nothing typechecks is how the
  // last one came to eat an argument silently.
  //
  // `voice.ts` is still out. It reaches into `src/`, which is browser code, and
  // surfaces exactly one error -- `globalThis.crypto` in `src/audio-clip.ts`,
  // undeclared without the DOM lib. Adding DOM here would declare browser
  // globals to a Node program to fix one line, so this waits for somebody
  // willing to give `voice.ts` its own project instead.
  //
  // `build-kb.ts` is listed for the ordinary reason rather than a special one:
  // it is the parser that decides what every answer the worker serves says, and
  // a parser nothing typechecks is how the last one came to eat an argument
  // silently.
  //
  // `leads/` is the sheet import and the generator: both write schools into
  // production, and a mapping nothing typechecks is a column that silently
  // stops existing. `leads/sources/` is where each register's parser lives.
  //
  // `es/` is the Spanish pack passes, listed for the same reason: they write the
  // file a Spanish learner reads, and nothing else would see them fail to compile.
  "include": ["partners.ts", "argv.ts", "build-kb.ts", "kb-push.ts", "mesh-key.ts", "mesh-dev.ts", "ask-eval.ts", "es/*.ts", "leads/*.ts", "leads/sources/*.ts", "statutes/*.ts", "statutes/sites/*.ts", "law-vectors.ts", "laws-store.ts", "live.ts"]
}
