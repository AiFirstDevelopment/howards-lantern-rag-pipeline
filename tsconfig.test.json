{
  // The suites run in Node, so they get Node's globals; the app's own tsconfig
  // stays browser-only so nothing in src/ can reach for them by accident.
  // vite/client comes along because the suites import src modules that use
  // Vite's own import.meta extensions (import.meta.glob).
  "extends": "./tsconfig.json",
  //
  // `@cloudflare/workers-types` is here for the same reason scripts/tsconfig.json
  // carries it: tests/unit/knowledge-base.test.ts imports the worker's own
  // constants -- the payout floor, the link expiry, the refund window -- to hold
  // the knowledge base to them, and those modules speak D1. A test that retyped
  // 5000 instead would agree with itself for ever.
  "compilerOptions": {
    "types": ["node", "vite/client", "@cloudflare/workers-types"]
  },
  // scripts/build-learner-kb.ts and its eval are here rather than in
  // scripts/tsconfig.json: they import src/access.ts, which reaches for
  // `localStorage` inside its functions, and the scripts project has no DOM lib.
  "include": ["tests", "vitest.config.ts", "playwright.config.ts", "scripts/build-learner-kb.ts", "scripts/learner-ask-eval.ts"]
}
