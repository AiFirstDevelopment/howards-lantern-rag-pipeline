{
  // The worker's suites run under Vitest, which loads its config in Node while
  // the tests themselves run in workerd. So this one config sees both, and the
  // worker's own tsconfig stays Workers-only so nothing in src/ can reach for a
  // Node global by accident -- the same split the app makes.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers", "node"]
  },
  "include": ["tests", "vitest.config.ts"]
}
