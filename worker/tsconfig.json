{
  // The worker runs on the Workers runtime, not in a browser and not in Node,
  // so it gets Cloudflare's globals and neither of the others.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    // The knowledge base ships as JSON: `worker/src/knowledge-base.json`, built
    // from the markdown beside it by `npm run kb:build`. Nothing under src/
    // imports markdown -- wrangler has no loader for it -- so the parse happens
    // in Node and the worker imports data.
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
